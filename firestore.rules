rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.uid == 'C7uoRRiH1XdpJzLDZMCZHLsmpNv1'
        && request.auth.token.get('admin', false) == true;
    }
    function access() { return admin() || dashboard(); }
    function dashboard() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'password'
        && exists(/databases/$(database)/documents/dashboardApprovals/$(request.auth.uid))
        && get(/databases/$(database)/documents/dashboardApprovals/$(request.auth.uid)).data.status == 'approved';
    }
    function reviewAccess() { return access(); }
    function self(uid) { return request.auth != null && request.auth.uid == uid; }
    match /dashboardApprovals/{uid} {
      allow get: if self(uid) || admin();
      allow list: if admin();
      // Only drgigy can provision an immediately enabled account. Other sign-ins can request access only.
      allow create: if (self(uid)
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'password'
        && request.resource.data.keys().hasOnly(['email', 'status', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time)
        || (admin()
          && request.resource.data.keys().hasOnly(['email', 'status', 'createdBy', 'createdAt', 'reviewedBy', 'reviewedAt'])
          && request.resource.data.email is string && request.resource.data.email.size() <= 254
          && request.resource.data.status == 'approved'
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.createdAt == request.time && request.resource.data.reviewedAt == request.time);
      allow update: if admin()
        && request.resource.data.status in ['pending', 'approved', 'blocked']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time;
    }
    // Historical device records are retained; they no longer grant clinical access.
    match /deviceApprovals/{uid} {
      allow read: if admin();
      allow write: if false;
    }
    // Shared Gemini key is delivered only to server-approved identities.
    // The key never lives in public configuration, approval records or source files.
    match /runtimeSecrets/gemini {
      allow get: if reviewAccess();
      allow list: if false;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['key', 'enabled', 'version', 'updatedBy', 'updatedAt'])
        && request.resource.data.key is string && request.resource.data.key.size() <= 256
        && request.resource.data.enabled is bool
        && ((!request.resource.data.enabled && request.resource.data.key == '')
          || (request.resource.data.enabled && request.resource.data.key.size() >= 20))
        && request.resource.data.version is string && request.resource.data.version.size() <= 64
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow read: if reviewAccess();
      allow create, update: if access() && self(uid)
        && request.resource.data.keys().hasOnly(['credentialName', 'credentialUpdatedAt', 'prescriptionLayout', 'prescriptionLayoutUpdatedAt', 'email', 'emailUpdatedAt']);
    }
    match /workspaces/stroke/dictationJobs/{jobId} {
      allow read: if access();
      allow create, update, delete: if false;
    }
    match /workspaces/stroke/notes/{noteId} {
      allow read: if reviewAccess();
      allow create: if access() && validNote() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string && request.resource.data.createdAt == request.time
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow update: if reviewAccess() && validNote()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if access();
      function validNote() {
        return request.resource.data.transcription is string && request.resource.data.visitDate is string
          && request.resource.data.isDraft is bool && request.resource.data.visitType in ['OP', 'IP'];
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
