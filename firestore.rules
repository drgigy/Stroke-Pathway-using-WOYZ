rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    function approved() {
      return request.auth != null && exists(/databases/$(database)/documents/deviceApprovals/$(request.auth.uid))
        && get(/databases/$(database)/documents/deviceApprovals/$(request.auth.uid)).data.status == 'approved';
    }
    function access() { return admin() || approved(); }
    function self(uid) { return request.auth != null && request.auth.uid == uid; }
    function validDevice() {
      return request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.department is string && request.resource.data.department.size() > 0 && request.resource.data.department.size() <= 100
        && request.resource.data.deviceLabel is string && request.resource.data.deviceLabel.size() <= 100;
    }
    match /deviceApprovals/{uid} {
      allow get: if self(uid) || admin();
      allow list: if admin();
      allow create: if self(uid) && validDevice()
        && request.resource.data.keys().hasOnly(['name', 'department', 'deviceLabel', 'deviceCode', 'status', 'createdAt', 'lastSeenAt'])
        && request.resource.data.status == 'pending' && request.resource.data.deviceCode is string
        && request.resource.data.deviceCode.size() == 13
        && request.resource.data.createdAt == request.time && request.resource.data.lastSeenAt == request.time;
      allow update: if self(uid) && validDevice() && resource.data.status != 'blocked'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'department', 'deviceLabel', 'lastSeenAt'])
        && request.resource.data.lastSeenAt == request.time;
      allow update: if admin() && request.resource.data.status in ['pending', 'approved', 'blocked']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time;
    }
    match /users/{uid} {
      allow read: if access();
      allow create, update: if access() && self(uid)
        && request.resource.data.keys().hasOnly(['credentialName', 'credentialUpdatedAt', 'prescriptionLayout', 'prescriptionLayoutUpdatedAt', 'email', 'emailUpdatedAt']);
    }
    match /workspaces/stroke/notes/{noteId} {
      allow read: if access();
      allow create: if access() && validNote() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string && request.resource.data.createdAt == request.time
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow update: if access() && validNote()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if access();
      function validNote() {
        return request.resource.data.transcription is string && request.resource.data.visitDate is string
          && request.resource.data.isDraft is bool && request.resource.data.visitType in ['OP', 'IP'];
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
