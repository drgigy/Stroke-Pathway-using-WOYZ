rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validCaseId(caseId) {
      return caseId.matches('ST-[A-Za-z0-9_-]{1,32}');
    }

    function validCaseShape(caseId) {
      return request.resource.data.keys().hasOnly([
        'ownerUid',
        'episode',
        'episodeId',
        'patientId',
        'stage',
        'data',
        'version',
        'updatedAt',
        'updatedAtText',
        'mutationId',
        'patient',
        'registration',
        'times',
        'observations',
        'scan',
        'decision',
        'ivt',
        'mt',
        'monitoring',
        'review24',
        'review48',
        'discharge',
        'final',
        'followup',
        'audit',
        'voiceSegments'
      ])
      && request.resource.data.ownerUid == request.auth.uid
      && (!('episode' in request.resource.data) || request.resource.data.episode == caseId)
      && (!('data' in request.resource.data) || request.resource.data.data is map)
      && (!('version' in request.resource.data) || request.resource.data.version is int);
    }

    match /strokeCases/{caseId} {
      allow get: if request.auth != null
        && validCaseId(caseId)
        && (
          !exists(/databases/$(database)/documents/strokeCases/$(caseId))
          || resource.data.ownerUid == request.auth.uid
        );
      allow list: if false;
      allow create: if request.auth != null
        && validCaseId(caseId)
        && validCaseShape(caseId);
      allow update: if request.auth != null
        && validCaseId(caseId)
        && validCaseShape(caseId)
        && resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
